[Unit]
Description=yt-dlp lane check every 6 h (as user ytdlp; switched only if the new one plays)

[Timer]
# docs/ota.md "The component lane (yt-dlp)". Cheap when nothing is new: one
# signed components.json fetch. haslerd also starts the service when the
# network comes back after a long time, and when YouTube Music tracks fail.
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=1h
# Catch up after the box has been switched off over the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
