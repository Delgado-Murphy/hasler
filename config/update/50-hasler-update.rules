// polkit: haslerd may start exactly the key page's update/rollback requests,
// nothing else. Instance names are checked here AND again by the updater.
// -> /etc/polkit-1/rules.d/50-hasler-update.rules
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "haslerd" &&
        action.lookup("verb") == "start" &&
        /^hasler-update-apply@([0-9]{1,9}|rollback|rollback-[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?)\.service$/
            .test(action.lookup("unit"))) {
        return polkit.Result.YES;
    }
});
