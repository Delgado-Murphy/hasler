# haslerd (runs as pi): clean shutdown from the panel, joining a new Wi-Fi
# from the captive portal (the helper takes SSID/password on stdin, writes
# moOde's network tables, reboots), and the mono switch on the key page (adds
# or removes one ALSA override file). Nothing else.
# -> /etc/sudoers.d/haslerd (0440, checked with visudo -cf first). Shipped in
# every release as integration/sudoers/haslerd; scripts/install.sh renders it
# for the legacy layout. Updates and yt-dlp go through polkit, not sudo.
pi ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /bin/systemctl poweroff, /usr/local/sbin/hasler-wifi-join, /usr/local/sbin/hasler-audio-mono
