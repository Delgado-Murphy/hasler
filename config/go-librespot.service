[Unit]
Description=go-librespot (Spotify Connect, driven by haslerd)
# Shipped in every release; the binary is the release's pinned one. The legacy
# rsync install uses config/legacy/go-librespot.service.
# Not network-online (it held the boot ~6 s, docs/build-guide.md "Boot time").
# Zeroconf is off (config.yml), so nothing binds to an interface at start; with
# no network yet it fails to reach Spotify and Restart= below retries every 5 s
# until Wi-Fi is up. haslerd only talks to it over 127.0.0.1:3678.
After=sound.target network.target
# Never give up retrying while offline (the default limit is 5 starts in 10 s;
# RestartSec=5 stays under it, this makes it explicit).
StartLimitIntervalSec=0

[Service]
# Config and the one-time login (state.json, credentials) live outside the
# release, in /var/lib/go-librespot (scripts/ota-bootstrap.sh copies them over
# from ~pi/.config/go-librespot once).
ExecStart=/opt/hasler/current/bin/go-librespot --config_dir /var/lib/go-librespot
Restart=always
RestartSec=5
User=pi
SupplementaryGroups=audio
StateDirectory=go-librespot
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
