[Unit]
Description=Hasler panel daemon
# Shipped in every release as integration/systemd/haslerd.service and put in
# place by the updater (docs/ota.md). The legacy rsync install uses
# config/legacy/haslerd.service instead.
# Not network-online: haslerd plays local and cached sources offline and
# copes with the network arriving later, and waiting for it held the boot
# (docs/build-guide.md "Boot time"). Not After=go-librespot either: it is
# optional at runtime - haslerd logs and carries on without it. After=mpd only
# orders: with --early-mpd MPD is in the boot transaction, otherwise moOde's
# worker starts it later and haslerd retries.
After=network.target mpd.service
# Clean-shutdown marker (/var/lib/haslerd/clean-shutdown): written at a clean
# shutdown or reboot by hasler-clean-shutdown.service, read and deleted by
# haslerd at start; missing = the power was cut. Wants=, so no `enable` needed.
Wants=hasler-clean-shutdown.service
# Boot config guard (docs/build-guide.md "Boot config guard"): the early repair
# of a config.txt a power cut broke (ordered before rc-local and this unit by
# its own Before=) and the timer that refreshes the known-good copy after boot.
Wants=hasler-bootcfg-guard.service hasler-bootcfg-save.timer
# Wi-Fi from a file on the SD card (only runs when the file is there).
Wants=hasler-wifi-rescue.service
# Remote help: start again after a restart within the owner's 24-hour yes,
# and from hasler-help.txt on the SD card (each only when its file is there).
Wants=hasler-help-resume.service hasler-help-rescue.service
# Debian security updates at night (docs/ota.md §6; the script decides when).
Wants=hasler-os-update.timer
# The early boot lamp (hasler-lamp-boot) breathes until haslerd takes the
# LED: haslerd asks it to let go (/run/hasler-lamp/takeover) right before its
# first frame, so it breathes through Python's start instead of freezing.
# After= so haslerd never starts before it; ExecStartPost= below stops it
# anyway (for a lamp script too old to answer), so only one of them ever
# writes the LED. Not Conflicts=: both are in the same boot transaction, and
# systemd would resolve the conflict by dropping the lamp's start job - no
# boot breath at all. docs/lamp.md "Boot and shutdown", lamp/handover.py.
After=hasler-lamp-boot.service
# Update failsafe: a crash loop (5 starts in 120 s) ends in "failed", which
# starts the updater's rollback - it acts only during an update's trial or
# probation, and is a no-op otherwise.
OnFailure=hasler-update-rollback.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
# '+' = as root (we are User=pi); '-' = fine if the unit is not installed.
# SIGTERM leaves the LED at its last duty, so there is no dark gap. After
# READY, by which time haslerd has taken the LED over (a no-op then).
ExecStartPost=-+/usr/bin/systemctl stop hasler-lamp-boot.service
# The radio's own files back to its user if an older updater left them root's
# (scripts/hasler-own-state; a no-op normally).
ExecStartPre=-+/usr/local/sbin/hasler-own-state
# Between two haslerds (a restart, a crash, an update) the boot script
# breathes on from the LED's last frame - never dark, which means unplug.
# Not at a shutdown: haslerd left a steady ember for the halt hook.
ExecStopPost=-+/usr/local/sbin/hasler-lamp-boot --handover
# The release's own venv; box settings, calibration and trust in /etc/hasler,
# web-written config, state and secrets in /var/lib/haslerd.
ExecStart=/opt/hasler/current/venv/bin/python -m haslerd.main --etc /etc/hasler
WorkingDirectory=/var/lib/haslerd
# The release's bin/ first: deno (yt-dlp's JS runtime) and go-librespot.
Environment=PATH=/opt/hasler/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The release tree is root-owned and read-only; it is precompiled at install.
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=3
User=pi
# GPIO and I2C access without running as root; video for vcgencmd (/dev/vcio: the throttle
# word on kernels without the sysfs file, lamp/faults.py); systemd-journal so the
# support bundle (/api/diagnostics/bundle, web/diagnostics.py) can read the
# haslerd / mpd journal tail without sudo.
SupplementaryGroups=gpio i2c audio video systemd-journal
# /var/lib/haslerd, owned by User=. state.json, keys.yaml, settings.json, secrets/.
StateDirectory=haslerd

[Install]
WantedBy=multi-user.target
