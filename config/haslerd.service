[Unit]
Description=Hasler panel daemon
# Shipped in every release as integration/systemd/haslerd.service and put in
# place by the updater (docs/ota.md). The legacy rsync install uses
# config/legacy/haslerd.service instead.
# go-librespot is optional at runtime - haslerd logs and carries on without it.
After=network-online.target mpd.service go-librespot.service
Wants=network-online.target
# The early boot lamp (hasler-lamp-boot) breathes until haslerd starts.
# After= so haslerd never starts before it; ExecStartPre= below stops it so
# only one of them ever writes the LED. Not Conflicts=: both are in the same
# boot transaction, and systemd would resolve the conflict by dropping the
# lamp's start job - no boot breath at all.
After=hasler-lamp-boot.service
# Update failsafe: a crash loop (5 starts in 120 s) ends in "failed", which
# starts the updater's rollback - it acts only during an update's trial or
# probation, and is a no-op otherwise.
OnFailure=hasler-update-rollback.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
# '+' = as root (we are User=pi); '-' = fine if the unit is not installed.
# SIGTERM leaves the LED at its last duty, so there is no dark gap.
ExecStartPre=-+/usr/bin/systemctl stop hasler-lamp-boot.service
# The release's own venv; box settings, calibration and trust in /etc/hasler,
# web-written config, state and secrets in /var/lib/haslerd.
ExecStart=/opt/hasler/current/venv/bin/python -m haslerd.main --etc /etc/hasler
WorkingDirectory=/var/lib/haslerd
# The release's bin/ first: deno (yt-dlp's JS runtime) and go-librespot.
Environment=PATH=/opt/hasler/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The release tree is root-owned and read-only; it is precompiled at install.
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=3
User=pi
# GPIO and I2C access without running as root.
SupplementaryGroups=gpio i2c audio
# /var/lib/haslerd, owned by User=. state.json, keys.yaml, settings.json, secrets/.
StateDirectory=haslerd

[Install]
WantedBy=multi-user.target
