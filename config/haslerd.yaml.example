# Copy to config/haslerd.yaml on the Pi. Not committed - it holds a token.

moode:
  mpd_host: localhost
  mpd_port: 6600
  # From: moodeutl -q "select value from cfg_system where param='amixname'"
  # This must be the HARDWARE mixer - it is what makes one knob control
  # Bluetooth and AirPlay as well as the radio.
  mixer: Digital
  # ALSA card id (or index) - from: cat /proc/asound/cards. With moOde's two
  # HDMI cards in front, the Amp4 Pro is index 2; the id doesn't move.
  card: sndrpihifiberry
  # Ceiling on the mixer, as a percentage of full scale.
  # The Hasler's speaker measures 14.2 ohm DCR -> ~16 ohm nominal. The Amp4 Pro
  # will put ~10 W into that; the vintage cone is good for maybe 1-3 W. Turn
  # this up slowly, by ear, until it is as loud as you ever want it - then stop.
  # The knob keeps its full sweep either way; it just tops out somewhere safe.
  volume_limit: 70

  # spotify: presets. go-librespot's local API - see config/go-librespot/config.yml.
  # Needs Spotify Premium and the one-time login in build guide Phase 3c.
  spotify:
    enabled: true
    base_url: http://127.0.0.1:3678

  # ytm: presets. haslerd serves http://127.0.0.1:<port>/ytm/<id> to MPD and
  # redirects each request to a stream yt-dlp resolves fresh. Keep the port
  # fixed - radio uses it to tell a ytm track from a station.
  ytm:
    enabled: true
    port: 8099
    ytdlp: yt-dlp        # on PATH via /usr/local/bin; or an absolute path
    # Netscape cookies.txt for private playlists. Empty = public only, or the
    # cookies from the key page's YouTube Music sign-in (written to
    # /var/lib/haslerd/secrets/ytm-cookies.txt, mode 600) once someone signs in there.
    cookies: ""
    # ytmusicapi: search on the key page, track names in moOde, endless radio
    # presets, Liked songs. false = yt-dlp only.
    catalog: true

# Last preset, resumed after a power-cycle. systemd creates the directory
# (StateDirectory=haslerd); it must be writable by the service user.
state_file: /var/lib/haslerd/state.json

# The key page: http://hasler.local:8080 - choose what each key does on tap
# and hold. LAN only, no login (like moOde's own UI). Choices are saved to
# keys.yaml next to state_file and laid over the descriptor's defaults.
web:
  enabled: true
  port: 8080
  # Remote help (docs/remote-help.md): the makers' Tailscale tailnet. A radio
  # that joins any other tailnet ends help at once. Default
  # delgado-murphy.org.github; "" switches the check off.
  # help_tailnet: delgado-murphy.org.github

# Optional, and normally left empty: connect Home Assistant from the key page
# instead (Settings -> Home Assistant: it finds HA on the network, checks the
# token and saves it to /var/lib/haslerd/secrets/ha.json, mode 0600, which wins over
# this block). Kept for setups configured by hand before the page existed.
# Without any HA the box is fully standalone and HA key actions do nothing.
# Long-lived token: HA profile -> Security -> Long-lived access tokens.
# home_assistant:
#   url: http://homeassistant.local:8123   # whatever HA the home has
#   token: ""
#   publish: false   # true: push what's playing to HA as sensor.hasler_radio
