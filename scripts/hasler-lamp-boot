#!/usr/bin/python3
"""Early-boot pilot lamp: fade into an amber breath until haslerd takes over.

docs/lamp.md "Boot and shutdown", stage "~3-5 s". Started by
hasler-lamp-boot.service as soon as udev has loaded the pwm-gpio driver; it
stops itself when haslerd asks for the LED (/run/hasler-lamp/takeover, below)
and haslerd.service's ExecStartPost stops it anyway (SIGTERM) for a haslerd
too old to ask.

What it shows: a slow 2 s fade from dark up to a clearly visible amber, then a breath between 25 % and 60 %
(perceptual), 3 s period, raised cosine. Perceptual -> linear with gamma 2.2,
then the amber balance R 1.0 / G 0.15 / B 0. We cannot read the tone knob yet
(that needs I2C and the panel), so it is always amber; haslerd corrects to
ember within a second or two of starting if the knob is off. haslerd's own
warm-up carries this very breath on (main.py LampKeeper.take_over).

Between two haslerds (a restart, a crash, an update; lamp/handover.py) it
breathes too: haslerd.service's ExecStopPost runs ``hasler-lamp-boot
--handover``, which reads the note haslerd left in /run/hasler-lamp/handover
and starts this service again unless the box is shutting down (then haslerd
left a steady ember for the halt hook). Started with a fresh note, it
continues from whatever the LED shows - no fade from dark, no jump - into the
amber breath, or the busy breath (don't unplug) while an update is installed.

haslerd's notes (/var/lib/haslerd/lamp-boot.json, lamp/handover.py
boot_doc): whether it was night, and each breath as haslerd's engine draws it
on this very lamp - calibrated colours and floors, night levels, the engine's
busy breath (slow, 6 s) - as one cycle of linear duty frames. With them the
script plays those frames (so a power cut at 3 am wakes to the night breath,
not 25-60 %); without them, or with anything odd in them, it falls back to
its own breaths below (stdlib only, never fails for want of the file).

Hardware (docs/hardware.md "Pilot lamp"): common-anode RGB LED on 3.3 V, red
GPIO17, green GPIO22, blue GPIO27, GPIO LOW = lit. Each pin is its own
pwm-gpio chip (dtoverlay=pwm-gpio,gpio=N in config.txt), channel pwm0. We set
the channel's polarity to "inversed", so duty_cycle is the *lit* time and a
disabled channel idles HIGH = dark (the driver drives the idle level from the
polarity). No manual duty inversion anywhere.

PWM period: the one haslerd configured (io.lamp.pwm_hz), which it leaves in
/var/lib/haslerd/lamp-period; 800 Hz without that file. A channel that is
already running keeps its period (a handover never changes it).

Discovery (the same rule as haslerd/lamp/outputs.py): a pwmchip belongs to
GPIO N when its device/of_node/compatible says "pwm-gpio" and the second cell
of device/of_node/gpios (<&gpio N flags>, big-endian u32) is N. If not all
three answer that way, fall back to the pwm-gpio chips (or every chip, if none
says) in pwmchip-number order = the overlay declaration order 17, 22, 27.

When it stops (SIGTERM / SIGINT / haslerd's takeover) it just stops: pins
stay exported and enabled at the last duty (the kernel keeps the PWM running),
so there is no dark gap before haslerd writes. /run/hasler-lamp/boot holds its
state for haslerd: the breath (colour, floor, peak, period_s, t0 on
CLOCK_MONOTONIC), its pid while it runs, "released": true once it let go.
The directory is group gpio and group-writable, so haslerd (User=pi, group
gpio) can leave its notes there.

Testing without a Pi (fake sysfs; the script creates pwm0/ on "export"):

    HASLER_PWM_ROOT=/tmp/fakepwm HASLER_LAMP_RUN=/tmp/lamprun \\
        scripts/hasler-lamp-boot --fake-sysfs --print

  --fake-sysfs   build pwmchip0..2 for GPIO 17/22/27 under HASLER_PWM_ROOT first
  --print        log every frame's perceptual level and duties to stdout
  --seconds N    stop by itself after N seconds (default: run until killed)
  --handover     ExecStopPost's step (above), then exit; HASLER_SYSTEMCTL
                 names another systemctl for tests

Python stdlib only (no venv - it runs long before the user's session).
"""

from __future__ import annotations

import argparse
import grp
import json
import math
import os
import signal
import struct
import subprocess
import sys
import time

ROOT = os.environ.get("HASLER_PWM_ROOT", "/sys/class/pwm")
FAKE = "HASLER_PWM_ROOT" in os.environ
STATE_DIR = os.environ.get("HASLER_LAMP_RUN", "/run/hasler-lamp")
PERIOD_FILE = os.environ.get("HASLER_LAMP_PERIOD_FILE", "/var/lib/haslerd/lamp-period")
# haslerd's notes: night or day, and its breaths as frames (boot_table below).
BOOT_FILE = os.environ.get("HASLER_LAMP_BOOT_FILE", "/var/lib/haslerd/lamp-boot.json")
SYSTEMCTL = os.environ.get("HASLER_SYSTEMCTL", "systemctl")
UNIT = "hasler-lamp-boot.service"
GROUP = "gpio"                    # haslerd's SupplementaryGroups

GPIOS = (17, 22, 27)              # red, green, blue - overlay declaration order
PERIOD_NS = 1_250_000             # 800 Hz, unless haslerd left another (PERIOD_FILE)
GAMMA = 2.2
FADE_S = 2.0                      # a slow, visible fade up (the owner likes it slow)
FPS = 40                          # smooth enough for a 3 s breath, ~nothing on CPU
WAIT_CHIPS_S = 10.0               # udev may still be loading pwm-gpio
CONTINUE_S = 1.0                  # a handover: from the LED's frame into the breath
HANDOVER_FRESH_S = 60.0           # an older note is a leftover, not a handover

# The breaths, perceptual (docs/lamp.md; lamp/policy.py's names in brackets).
LOOKS = {
    # 0.10/0.35 read as 'off' on this LED (bench, 20 Oct)
    "amber": {"floor": 0.25, "peak": 0.60, "period_s": 3.0, "balance": (1.0, 0.15, 0.0)},
    # [SHUTTING_DOWN / UPDATING]: busy, don't unplug. Pure red, as the engine
    # draws deep ember (its trace of green is under the floor).
    "ember": {"floor": 0.15, "peak": 0.35, "period_s": 2.5, "balance": (1.0, 0.0, 0.0)},
}
FLOOR, PEAK = LOOKS["amber"]["floor"], LOOKS["amber"]["peak"]
BREATH_S = LOOKS["amber"]["period_s"]
BALANCE = LOOKS["amber"]["balance"]

running = True


def log(msg: str) -> None:
    print(f"hasler-lamp-boot: {msg}", file=sys.stderr, flush=True)


def read(path: str) -> str:
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def write(path: str, value: object) -> bool:
    try:
        with open(path, "w") as f:
            f.write(f"{value}\n")
        return True
    except OSError as e:
        log(f"write {value} -> {path}: {e.strerror}")
        return False


def to_int(text: str) -> int | None:
    try:
        return int(text)
    except ValueError:
        return None


def configured_period() -> int:
    """haslerd's period (PERIOD_FILE), else 800 Hz."""
    value = to_int(read(PERIOD_FILE))
    return value if value and 1000 <= value <= 100_000_000 else PERIOD_NS


# --- discovery (keep identical to haslerd/lamp/outputs.py) ------------------

def _is_pwm_gpio(chip: str) -> bool:
    try:
        with open(os.path.join(chip, "device/of_node/compatible"), "rb") as f:
            return b"pwm-gpio" in f.read().split(b"\0")
    except OSError:
        return False


def _gpio_of(chip: str) -> int | None:
    try:
        with open(os.path.join(chip, "device/of_node/gpios"), "rb") as f:
            cells = f.read()
        return struct.unpack(">I", cells[4:8])[0]   # <&gpio N flags>
    except (OSError, struct.error):
        return None


def discover() -> list[str] | None:
    """[red, green, blue] chip dirs, or None while they are not all there."""
    try:
        names = [n for n in os.listdir(ROOT) if n.startswith("pwmchip")]
    except OSError:
        return None
    chips = sorted((os.path.join(ROOT, n) for n in names if n[7:].isdigit()),
                   key=lambda p: int(os.path.basename(p)[7:]))
    pwm_gpio = [c for c in chips if _is_pwm_gpio(c)]
    by_gpio = {_gpio_of(c): c for c in pwm_gpio}
    if all(g in by_gpio for g in GPIOS):
        return [by_gpio[g] for g in GPIOS]
    candidates = pwm_gpio or chips          # fallback: declaration order
    if len(candidates) >= len(GPIOS):
        log("can't tell which pwmchip drives which GPIO; assuming "
            "declaration order")
        return candidates[: len(GPIOS)]
    return None


# --- one channel ------------------------------------------------------------

class Channel:
    def __init__(self, chip: str, period: int):
        self.dir = os.path.join(chip, "pwm0")
        self.duty = -1
        if not os.path.isdir(self.dir):
            write(os.path.join(chip, "export"), 0)
            if FAKE:
                os.makedirs(self.dir, exist_ok=True)
            for _ in range(50):                 # the kernel adds pwm0/ at once;
                if os.path.isdir(self.dir):     # udev's chgrp follows shortly
                    break
                time.sleep(0.02)
        f = lambda name: os.path.join(self.dir, name)   # noqa: E731
        self.f_duty = f("duty_cycle")
        enabled = read(f("enable")) == "1"
        if read(f("polarity")) != "inversed":
            # Polarity only changes while disabled. Disabling with "normal"
            # drives the pin LOW (= lit) for a moment, so only do it if needed.
            if enabled:
                write(f("duty_cycle"), 0)
                write(f("enable"), 0)
            write(f("polarity"), "inversed")    # disabled + inversed -> HIGH, dark
            enabled = False
        current = to_int(read(f("period"))) or 0
        if enabled and current > 0:
            period = current                    # a handover: never change it (a blink)
        elif current != period:
            write(f("duty_cycle"), 0)           # duty must never exceed period
            write(f("period"), period)
        self.period = period
        if not enabled:
            write(f("duty_cycle"), 0)
            write(f("enable"), 1)
        self.duty = int(read(f("duty_cycle")) or 0)

    def lit(self) -> float:
        """The lit fraction it shows now (linear)."""
        return max(0.0, min(1.0, self.duty / self.period)) if self.period else 0.0

    def set(self, linear: float) -> int:
        duty = round(max(0.0, min(1.0, linear)) * self.period)
        if duty != self.duty and write(self.f_duty, duty):
            self.duty = duty
        return duty


# --- the look ---------------------------------------------------------------

def breath_at(phase: float, floor: float, peak: float) -> float:
    """Raised cosine; phase 0 = the peak (the fade up ends there)."""
    return floor + (peak - floor) * (1 + math.cos(2 * math.pi * phase)) / 2


def level_at(t: float) -> float:
    """Perceptual level t seconds after start: fade up to the peak, then breathe
    down and up again - so the first thing anyone sees is a clear glow."""
    if t < FADE_S:
        x = t / FADE_S
        return PEAK * x * x * (3 - 2 * x)       # smoothstep 0 -> peak
    return breath_at((t - FADE_S) / BREATH_S, FLOOR, PEAK)


def continue_at(t: float, start: float, look: dict) -> float:
    """A handover: from ``start`` (what the LED showed) into ``look``'s breath.

    The breath starts at the point nearest ``start`` (on its way down), and a
    CONTINUE_S smoothstep blends the two, so a level outside the breath's
    range glides in instead of jumping."""
    floor, peak, period = look["floor"], look["peak"], look["period_s"]
    x = (min(peak, max(floor, start)) - floor) / (peak - floor)
    phase0 = math.acos(max(-1.0, min(1.0, 2 * x - 1))) / (2 * math.pi)
    target = breath_at(phase0 + t / period, floor, peak)
    if t >= CONTINUE_S:
        return target
    w = t / CONTINUE_S
    w = w * w * (3 - 2 * w)
    return start + (target - start) * w


# --- haslerd's frames (lamp-boot.json, haslerd/lamp/handover.py boot_doc) ------

def boot_table(mode: str) -> dict | None:
    """haslerd's table for ``mode`` (amber | ember) tonight or today, or None.

    {"night": bool, "fps": n, "looks": {mode: {"day"|"night": {"floor",
    "peak", "period_s", "frames": [[r, g, b] linear duty, ...]}}}}: one cycle
    of the breath as haslerd's engine draws it on this lamp (calibration,
    floors, night levels). Anything odd: None, and the script's own breath."""
    try:
        with open(BOOT_FILE) as f:
            doc = json.load(f)
        entry = doc["looks"][mode]["night" if doc.get("night") else "day"]
        fps = float(doc["fps"])
        frames = [[max(0.0, min(1.0, float(c))) for c in fr] for fr in entry["frames"]]
        if fps <= 0 or not frames or any(len(fr) != 3 for fr in frames) or max(map(max, frames)) <= 0:
            return None
        floor, peak, period = float(entry["floor"]), float(entry["peak"]), float(entry["period_s"])
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None
    return {"fps": fps, "frames": frames, "floor": floor, "peak": peak, "period_s": period,
            "night": bool(doc.get("night"))}


class TablePlayer:
    """Plays a table's frames, looping. Cold (``start`` None): a FADE_S fade up
    from dark to the breath's brightest frame, then on from there. A handover:
    from the LED's duties (``start``) into the frame nearest them, blended
    over CONTINUE_S - no dark frame, no jump."""

    def __init__(self, table: dict, start: list | None) -> None:
        self.frames, self.fps = table["frames"], table["fps"]
        self.start = start
        if start is None:
            self.i0 = max(range(len(self.frames)), key=lambda i: max(self.frames[i]))
            self.lead = FADE_S
        else:
            p = [c ** (1.0 / GAMMA) for c in start]
            self.i0 = min(range(len(self.frames)), key=lambda i: sum(
                abs(c ** (1.0 / GAMMA) - q) for c, q in zip(self.frames[i], p)))
            self.lead = 0.0

    def frame(self, t: float) -> list:
        return self.frames[(self.i0 + int(max(0.0, t) * self.fps)) % len(self.frames)]

    def at(self, t: float) -> list:
        if self.start is None:
            if t < FADE_S:
                x = t / FADE_S
                x = x * x * (3 - 2 * x)                 # smoothstep, perceptual
                return [c * x ** GAMMA for c in self.frames[self.i0]]
            return self.frame(t - FADE_S)
        target = self.frame(t)
        if t >= CONTINUE_S:
            return target
        w = t / CONTINUE_S
        w = w * w * (3 - 2 * w)
        return [((a ** (1 / GAMMA)) + ((b ** (1 / GAMMA)) - (a ** (1 / GAMMA))) * w) ** GAMMA
                for a, b in zip(self.start, target)]


def make_fake_sysfs() -> None:
    for i, gpio in enumerate(GPIOS):
        node = os.path.join(ROOT, f"pwmchip{i}", "device", "of_node")
        os.makedirs(node, exist_ok=True)
        with open(os.path.join(node, "compatible"), "wb") as f:
            f.write(b"pwm-gpio\0")
        with open(os.path.join(node, "gpios"), "wb") as f:
            f.write(struct.pack(">III", 1, gpio, 0))
        for name, val in (("npwm", "1"), ("export", ""), ("unexport", "")):
            with open(os.path.join(ROOT, f"pwmchip{i}", name), "w") as f:
                f.write(val)
        pwm = os.path.join(ROOT, f"pwmchip{i}", "pwm0")
        os.makedirs(pwm, exist_ok=True)
        for name, val in (("period", "0"), ("duty_cycle", "0"),
                          ("enable", "0"), ("polarity", "normal")):
            with open(os.path.join(pwm, name), "w") as f:
                f.write(val + "\n")


# --- the notes in STATE_DIR (haslerd/lamp/handover.py) -----------------------

def state_dir() -> bool:
    """STATE_DIR, group gpio and group-writable for haslerd's notes."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
    except OSError:
        return False
    try:
        os.chown(STATE_DIR, -1, grp.getgrnam(GROUP).gr_gid)
        os.chmod(STATE_DIR, 0o2775)
    except (KeyError, OSError):
        pass                                    # no such group / not root: fine
    return True


def note(name: str) -> str:
    return os.path.join(STATE_DIR, name)


def save_state(doc: dict) -> None:
    try:
        tmp = note(".boot.tmp")
        with open(tmp, "w") as f:
            json.dump(doc, f)
        os.replace(tmp, note("boot"))
        os.chmod(note("boot"), 0o644)
    except OSError:
        pass


def take_handover() -> str | None:
    """A fresh note from haslerd's exit: its mode (amber | ember), used up."""
    path = note("handover")
    try:
        with open(path) as f:
            doc = json.load(f)
        os.unlink(path)
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict) or time.time() - float(doc.get("at") or 0) > HANDOVER_FRESH_S:
        return None
    mode = doc.get("mode")
    return mode if mode in LOOKS else None


def system_stopping() -> bool:
    try:
        out = subprocess.run([SYSTEMCTL, "is-system-running"], capture_output=True,
                             text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return False
    return out == "stopping"


def handover() -> int:
    """ExecStopPost: breathe on between two haslerds, unless the box is going down.

    haslerd's note says how (lamp/handover.py); a haslerd that crashed left
    none, and gets the amber breath. "hold" (a shutdown) and a stopping
    system leave the LED alone for the halt hook."""
    path = note("handover")
    try:
        with open(path) as f:
            doc = json.load(f)
    except (OSError, ValueError):
        doc = {}
    mode = doc.get("mode") if isinstance(doc, dict) else None
    if mode == "hold" or system_stopping():
        try:
            os.unlink(path)
        except OSError:
            pass
        return 0
    if mode not in LOOKS:
        mode = "amber"
    if state_dir():
        try:
            with open(path, "w") as f:
                json.dump({"mode": mode, "at": time.time()}, f)
        except OSError:
            pass
    try:
        subprocess.run([SYSTEMCTL, "--no-block", "start", UNIT], timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        log(f"could not start {UNIT}: {e}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--fake-sysfs", action="store_true")
    ap.add_argument("--print", action="store_true")
    ap.add_argument("--seconds", type=float, default=0.0)
    ap.add_argument("--handover", action="store_true")
    args = ap.parse_args()
    if args.handover:
        return handover()
    if args.fake_sysfs:
        if not FAKE:
            log("--fake-sysfs needs HASLER_PWM_ROOT"); return 2
        make_fake_sysfs()

    def stop(_sig, _frm):
        global running
        running = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    have_dir = state_dir()
    try:
        os.unlink(note("takeover"))             # a leftover from a haslerd before
    except OSError:
        pass
    mode = take_handover() if have_dir else None

    deadline = time.monotonic() + WAIT_CHIPS_S
    chips = discover()
    while chips is None and running and time.monotonic() < deadline:
        time.sleep(0.1)
        chips = discover()
    if chips is None:
        log(f"no pwm-gpio chips for GPIO {GPIOS} under {ROOT} - is "
            "dtoverlay=pwm-gpio in config.txt (and the box rebooted)?")
        return 0                                # nothing to do; haslerd copes
    log("chips: " + ", ".join(f"GPIO{g}={os.path.basename(c)}"
                              for g, c in zip(GPIOS, chips)))
    period = configured_period()
    channels = [Channel(c, period) for c in chips]

    look = LOOKS[mode or "amber"]
    balance = look["balance"]
    table = boot_table(mode or "amber")
    if table is not None:
        # haslerd's own frames (night-scaled, calibrated): its levels for the state.
        look = {**look, "floor": table["floor"], "peak": table["peak"], "period_s": table["period_s"]}
    start = 0.0
    lit = [ch.lit() for ch in channels]
    if mode is not None:
        # What the LED shows (the red channel carries both looks), perceptual.
        start = channels[0].lit() ** (1.0 / GAMMA)
        log(f"handover ({mode}): breathing on from {start:.2f}")
    player = TablePlayer(table, lit if mode else None) if table is not None else None

    t0 = time.monotonic()
    state = {"colour": mode or "amber", "t0_monotonic": t0,
             "fade_s": CONTINUE_S if mode else FADE_S, "floor": look["floor"],
             "peak": look["peak"], "period_s": look["period_s"], "pid": os.getpid()}
    if have_dir:
        save_state(state)

    frame = 1.0 / FPS
    nxt = t0
    takeover = note("takeover")
    p = start
    while running:
        if have_dir and os.path.exists(takeover):
            log("haslerd takes over")
            break
        t = time.monotonic() - t0
        if args.seconds and t >= args.seconds:
            break
        if player is not None:
            rgb = player.at(t)
            p = max(rgb) ** (1.0 / GAMMA)
            duties = [ch.set(d) for ch, d in zip(channels, rgb)]
        else:
            p = continue_at(t, start, look) if mode else level_at(t)
            lin = p ** GAMMA
            duties = [ch.set(lin * k) for ch, k in zip(channels, balance)]
        if args.print:
            print(f"{t:6.3f} level={p:.3f} duty_ns={duties}", flush=True)
        nxt += frame
        delay = nxt - time.monotonic()
        if delay > 0:
            time.sleep(delay)                   # a signal ends this early: fine
        else:
            nxt = time.monotonic()
    # Leave everything exactly as it is: exported, enabled, last duty.
    if have_dir:
        save_state({**state, "pid": None, "released": True, "level": round(p, 4)})
        try:
            os.unlink(takeover)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
