#!/usr/bin/python3
"""hasler-tone GAIN - the old tone knob command, kept for haslerd.yaml files
that still name it (``tone_commands: {tone: "/usr/local/bin/hasler-tone {gain}"}``).

It is ``hasler-dsp tone GAIN``: the treble shelf above ~2.5 kHz, centre
flat, -12 dB dark end, boosts halved, the master gain cancelling any boost.
haslerd itself now runs hasler-dsp (the knobs' effects, haslerd/dsp/).
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
DSP = os.path.join(HERE, "hasler-dsp")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("usage: hasler-tone GAIN_DB", file=sys.stderr)
        sys.exit(2)
    os.execv(DSP, [DSP, "tone", sys.argv[1]])
